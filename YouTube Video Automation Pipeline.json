{
  "name": "youyube automation",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        -128
      ],
      "id": "c778e4e6-5c91-496f-8946-33b4f3812acb",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": {{ JSON.stringify(\n            \"Convert the following YouTube script into exactly 6 visual scenes.\\n\\n\" +\n            \"Return ONLY valid JSON. No markdown. No explanation.\\n\\n\" +\n            \"Format:\\n\" +\n            \"[{\\\"keyword\\\":\\\"space galaxy\\\",\\\"description\\\":\\\"Beautiful galaxy in deep space\\\"}]\\n\\n\" +\n            \"SCRIPT:\\n\" +\n            $json.output\n          ) }}\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.5,\n    \"maxOutputTokens\": 1500,\n    \"thinkingConfig\": {\n      \"thinkingBudget\": 0\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        576,
        -128
      ],
      "id": "e1ec3c33-d8fa-46a7-981c-198c8d63c5df",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.candidates[0].content.parts[0].text;\n\n// Remove markdown code fences if Gemini adds them\nconst cleanText = text\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet scenes;\n\ntry {\n  scenes = JSON.parse(cleanText);\n} catch (error) {\n  throw new Error(\n    \"AI returned invalid JSON.\\n\\nAI Output:\\n\" + text\n  );\n}\n\nif (!Array.isArray(scenes)) {\n  throw new Error(\"AI output is not an array.\");\n}\n\nreturn scenes.map((scene, index) => ({\n  json: {\n    scene: index + 1,\n    keyword: scene.keyword,\n    description: scene.description\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -128
      ],
      "id": "2c895714-158a-4ee3-9ff3-c4f229bd2ef5",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "url": "https://pixabay.com/api/",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key"
            },
            {
              "name": "q",
              "value": "= {{ $json.output }}"
            },
            {
              "name": "image_type",
              "value": "photo"
            },
            {
              "name": "orientation",
              "value": "horizontal"
            },
            {
              "name": "per_page",
              "value": "3"
            },
            {
              "name": "safesearch",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1600,
        -128
      ],
      "id": "fcb96879-de66-4304-ab44-5da069202b29",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "url": "={{ $json.hits[0].largeImageURL }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1824,
        -48
      ],
      "id": "c816600a-ea66-4dd4-b2a6-db3fe043d646",
      "name": "HTTP Request2"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst imageUrls = [];\n\nfor (const item of items) {\n  const hits = item.json?.hits;\n\n  if (!Array.isArray(hits)) continue;\n\n  for (const hit of hits) {\n    const url = hit.largeImageURL || hit.webformatURL;\n\n    if (url && !imageUrls.includes(url)) {\n      imageUrls.push(url);\n    }\n  }\n}\n\nif (imageUrls.length < 6) {\n  throw new Error(\n    `Only ${imageUrls.length} images found. Need 6 images.`\n  );\n}\n\nlet script = $(\"AI Agent\").first().json.output;\n\nif (typeof script !== \"string\" || !script.trim()) {\n  throw new Error(\"AI Agent script is empty.\");\n}\n\nscript = script\n  .replace(/^```(?:text|json)?\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\n// Exactly 6 image scenes\nconst scenes = imageUrls.slice(0, 6).map((url) => ({\n  duration: 3.333,\n  elements: [\n    {\n      type: \"image\",\n      src: url,\n      fit: \"cover\"\n    }\n  ]\n}));\n\nreturn [\n  {\n    json: {\n      scenes,\n      voice_text: script\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -320
      ],
      "id": "e688ac84-1645-4af0-899e-ceea4f67515d",
      "name": "Code in JavaScript1"
    },
